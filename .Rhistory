kl_divergence_rowwise <- function(p, q) {
if (!identical(dim(p), dim(q))) {
stop("Matrices must have the same dimensions")
}
epsilon <- 1e-10
p <- pmax(p, epsilon)
q <- pmax(q, epsilon)
kl_values <- numeric(nrow(p))
for (i in 1:nrow(p)) {
kl_values[i] <- sum(p[i, ] * log(p[i, ] / q[i, ]))
}
kl_values[kl_values < 0 & abs(kl_values) < 1e-10] <- 0
return(kl_values)
}
