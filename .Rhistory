simulate_multinomial_logit_data <- function(n_obs,
beta,
n_normal = 0,
normal_mean = 0,
normal_sd = 1,
n_categorical = 0,
cat_levels = 3,
n_bernoulli = 0,
bernoulli_p = 0.5,
n_uniform = 0,
uniform_min = 1,
uniform_max = 5,
n_truncnorm = 0,
truncnorm_mean = 0,
truncnorm_sd = 1,
truncnorm_a = -1,
truncnorm_b = 1) {
n_alternatives <- nrow(beta)
total_vars <- n_normal +
n_categorical * (cat_levels - 1) +
n_bernoulli +
n_uniform +
n_truncnorm
if (ncol(beta) != total_vars) {
stop("Number of columns in beta must match total number of variables after encoding.")
}
generate_features <- function() {
features <- c()
# Normal
if (n_normal > 0)
features <- c(features, rnorm(n_normal, mean = normal_mean, sd = normal_sd))
# Categorical (1-hot encoding, drop one level)
if (n_categorical > 0) {
for (i in 1:n_categorical) {
cat_val <- sample(1:cat_levels, 1)
one_hot <- rep(0, cat_levels - 1)
if (cat_val < cat_levels)
one_hot[cat_val] <- 1
features <- c(features, one_hot)
}
}
# Bernoulli
if (n_bernoulli > 0)
features <- c(features, rbinom(n_bernoulli, 1, prob = bernoulli_p))
# Discrete Uniform
if (n_uniform > 0)
features <- c(features, sample(uniform_min:uniform_max, n_uniform, replace = TRUE))
# Truncated Normal
if (n_truncnorm > 0)
features <- c(features, rtruncnorm(n_truncnorm,
a = truncnorm_a,
b = truncnorm_b,
mean = truncnorm_mean,
sd = truncnorm_sd))
return(features)
}
data <- vector("list", n_obs)
choices <- integer(n_obs)
for (i in 1:n_obs) {
x <- generate_features()
utilities <- beta %*% x
probs <- exp(utilities - max(utilities))  # numerical stability
probs <- probs / sum(probs)
choices[i] <- sample(1:n_alternatives, 1, prob = probs)
data[[i]] <- x
}
data_matrix <- do.call(rbind, data)
return(list(X = data_matrix, y = choices))
}
