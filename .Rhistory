install.packages("philentropy")
library(philentropy)
kl_divergence <- function(P, Q) {
eps <- 1e-12
P <- pmax(P, eps)
Q <- pmax(Q, eps)
rowSums(P * log(P / Q))
}
mu_excl1 <- cbind(1,X)[,-c(2)]%*%realbeta[-c(2)]
logit_prob_excl1 <- exp(mu_excl1)/(1+exp(mu_excl1))
logit_prob_excl1 <- cbind(logit_prob_excl1, 1-logit_prob_excl1)
