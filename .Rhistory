js_divergence <- function(P, Q) {
eps <- 1e-12
P <- pmax(P, eps)
Q <- pmax(Q, eps)
M <- 0.5 * (P + Q)
0.5 * rowSums(P * log(P / M)) + 0.5 * rowSums(Q * log(Q / M))
}
mu_excl1 <- cbind(1,X)[,-c(2)]%*%realbeta[-c(2)]
logit_prob_excl1 <- exp(mu_excl1)/(1+exp(mu_excl1))
