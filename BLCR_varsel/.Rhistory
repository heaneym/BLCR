data('mcmc_output')
library(foreign)
library(dplyr)
library(BayesLCA)
library(pheatmap)
data2 <- read.spss('./LynnWalsh thesis data files/Working data file submitted.sav')
data2 <- as.data.frame(data2)
data <- read.spss('./LynnWalsh thesis data files/Thesis Cleaned File.sav')
data <- as.data.frame(data)
sleep_data_responses <- data[,65:99]
mapping <- c(
"Rarely (0-1 times per week)" = 1,
"Sometimes (2-4 times per week)" = 2,
"Usually (5-7 times per week)" = 3
)
sleep_data_responses_numeric <- sleep_data_responses %>% mutate_all(~ mapping[as.character(.)])
df <- cbind(data[,c(35:48,56)],sleep_data_responses_numeric)
df$Diagnosis_ID <- ifelse(is.na(df$Diagnosis_ID),0,1)
df$Diagnosis_CerebralPalsy <- ifelse(is.na(df$Diagnosis_CerebralPalsy),0,1)
df$Diagnosis_ASD <- ifelse(is.na(df$Diagnosis_ASD),0,1)
df$Diagnosis_ADHD <- ifelse(is.na(df$Diagnosis_ADHD),0,1)
df$Diagnosis_DS <- ifelse(is.na(df$Diagnosis_DS),0,1)
df$Diagnosis_Other <- ifelse(is.na(df$Diagnosis_Other),0,1)
df$Diagnosis_None <- ifelse(is.na(df$Diagnosis_None),0,1)
#I'm gonna remove rows that are almost all NA (all indicator variables are missing)
df <- df[complete.cases(df[,16]),]
colnames(df)[16:50] <-c('BR1','BR2','BR3','BR4','BR5','BR6','SOD1','SD1','SD2','SD3','SA1','SA2','SA3','SA4','NW1','NW2','NW3','P1','P2','P3','P4','P5','P6','P7','SDB1', 'SDB2', 'SDB3', 'DS1','DS2','DS3','DS4','DS5','DS6','DS7','DS8')
#reverse scoring the negative items
df$BR1 <- 4 - df$BR1
df$BR2 <- 4 - df$BR2
df$SOD1 <- 4 - df$SOD1
df$SD2 <- 4 - df$SD2
df$SD3 <- 4 - df$SD3
df$DS1 <- 4 - df$DS1
sleep_data_total_score <- rowSums(df[,16:50])
sleep_disorders <- ifelse(sleep_data_total_score >= 41,1,0)
df <- cbind(df,sleep_data_total_score,sleep_disorders)
hist(df$sleep_data_total_score, main = 'population total scores', probability = TRUE)
Other_indices <- c(8,13,49,54,81,131)
df_neurodiverse_group <- df[df$Diagnosis_ASD == 1 | df$Diagnosis_ADHD == 1 | rownames(df) %in% Other_indices, ]
df_neurotypical_group <- df[!(df$Diagnosis_ASD == 1 | df$Diagnosis_ADHD == 1 | rownames(df) %in% Other_indices), ]
p1 <- hist(df_neurodiverse_group$sleep_data_total_score, main = 'Neurodiverse group total scores', probability = TRUE)
p2 <- hist(df_neurotypical_group$sleep_data_total_score, main = 'Neurotypical group total scores', probability = TRUE)
mean_CSHQ_nd <- mean(df_neurodiverse_group$sleep_data_total_score)
mean_CSHQ_nt <- mean(df_neurotypical_group$sleep_data_total_score)
t.test(df_neurodiverse_group$sleep_data_total_score, df_neurotypical_group$sleep_data_total_score, var.equal = FALSE)
