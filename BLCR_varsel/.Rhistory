G <- 3
p <- 1
M <- 4
n <- 1000
#theta1 <- matrix(c(0.8,0.2,0.2,0.8, 0.3,0.7), nrow = G, byrow = TRUE)
theta1 <- matrix(c(0.8,0.2,0.3,0.7,0.2,0.8), nrow = G, byrow = TRUE)
theta3 <- matrix(c(0.7,0.3,0.4,0.6,0.2,0.8), nrow = G, byrow = TRUE)
theta2 <- matrix(c(0.9,0.1,0.5,0.5,0.1,0.9), nrow = G, byrow = TRUE)
theta4 <- matrix(c(0.6,0.4,0.3,0.7,0.8,0.2), nrow = G, byrow = TRUE)
#theta2 <- matrix(c(0.4,0.3,0.2,0.1,0.2,0.4,0.3,0.1), nrow = 2, byrow = TRUE)
real_theta <- list(theta1,theta2,theta3,theta4)
real_beta <- matrix(c(-1,1,-1,1), nrow = p+1, ncol = G-1, byrow = TRUE)
data <- LCR_sim_data(theta = real_theta, beta = real_beta, n_samples = n)
list2env(data, envir = .GlobalEnv)
