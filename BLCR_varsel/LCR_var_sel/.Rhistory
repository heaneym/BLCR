# Ages we're keeping
ages <- 4:16
keep_indices <- (ages + 1)  # +1 because R indexing starts at 1, age 0 is index 1
# Define the count function
count_ages <- function(age_vec) {
age_tab <- table(factor(age_vec, levels = 0:18))
return(as.numeric(age_tab))
}
# Age counts for A, B, C
age_counts_A <- count_ages(df_latentgroupA$ChildAge)[keep_indices]
age_counts_B <- count_ages(df_latentgroupB$ChildAge)[keep_indices]
age_counts_C <- count_ages(df_latentgroupC$ChildAge)[keep_indices]
# Pooled DEF
df_DEF <- rbind(df_latentgroupD, df_latentgroupE, df_latentgroupF)
age_counts_pooled_DEF <- count_ages(df_DEF$ChildAge)[keep_indices]
# Convert to proportions
age_counts_prop_A <- age_counts_A / sum(age_counts_A)
age_counts_prop_B <- age_counts_B / sum(age_counts_B)
age_counts_prop_C <- age_counts_C / sum(age_counts_C)
age_counts_pooled_prop_DEF <- age_counts_pooled_DEF / sum(age_counts_pooled_DEF)
# Tidy dataframe for plot 1: Proportion within class
df_plot <- tibble(
Age = rep(ages, times = 4),
Proportion = c(age_counts_prop_A,
age_counts_prop_B,
age_counts_prop_C,
age_counts_pooled_prop_DEF),
Class = rep(c("A", "B", "C", "Pooled D+E+F"), each = length(ages))
)
# Plot 1
ggplot(df_plot, aes(x = Age, y = Proportion, color = Class)) +
geom_line(size = 1) +
geom_point() +
labs(title = "Age Distributions Within Each Latent Class",
x = "Child Age",
y = "Proportion within Class") +
theme_minimal() +
scale_color_brewer(palette = "Dark2")
# Matrix: rows = ages, columns = classes
age_given_class_mat <- cbind(
age_counts_prop_A,
age_counts_prop_B,
age_counts_prop_C,
age_counts_pooled_prop_DEF
)
# Priors: A, B, C, and pooled DEF
class_probs <- classprobs[c(1, 2, 3)]
pooled_prob_DEF <- sum(classprobs[4:6])
class_probs <- c(class_probs, pooled_prob_DEF)
# Bayes numerator
numerator_mat <- sweep(age_given_class_mat, 2, class_probs, FUN = "*")
# Denominator: sum across classes
denominator_vec <- rowSums(numerator_mat)
# Posterior
posterior_class_given_age <- numerator_mat / denominator_vec
# Optional: zeroing a row (e.g., to hide an age) — you can remove this if not needed
posterior_class_given_age[11,] <- 0  # Age 14 (11th row in 4:16)
# Convert to long format
df_posteriors <- as_tibble(posterior_class_given_age) %>%
mutate(Age = ages) %>%
pivot_longer(-Age, names_to = "Class", values_to = "PosteriorProb") %>%
mutate(Class = factor(Class, labels = c("A", "B", "C", "Pooled D+E+F")))
# Plot 2: Posterior Probabilities
ggplot(df_posteriors, aes(x = Age, y = PosteriorProb, color = Class)) +
geom_line(size = 1) +
geom_point() +
labs(title = "Posterior Class Probabilities Given Age",
x = "Child Age",
y = "P(Class | Age)") +
theme_minimal() +
scale_color_brewer(palette = "Dark2")
ggplot(df_plot, aes(x = factor(Age), y = Proportion, fill = Class)) +
geom_col() +
facet_wrap(~ Class, nrow = 2) +
labs(title = "Age Distribution Within Each Class",
x = "Child Age",
y = "Proportion") +
theme_minimal() +
theme(legend.position = "none")
