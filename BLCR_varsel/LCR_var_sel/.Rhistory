df <- cbind(data[,c(35:48,56)],sleep_data_responses_numeric)
df$Diagnosis_ID <- ifelse(is.na(df$Diagnosis_ID),0,1)
df$Diagnosis_CerebralPalsy <- ifelse(is.na(df$Diagnosis_CerebralPalsy),0,1)
df$Diagnosis_ASD <- ifelse(is.na(df$Diagnosis_ASD),0,1)
df$Diagnosis_ADHD <- ifelse(is.na(df$Diagnosis_ADHD),0,1)
df$Diagnosis_DS <- ifelse(is.na(df$Diagnosis_DS),0,1)
df$Diagnosis_Other <- ifelse(is.na(df$Diagnosis_Other),0,1)
df$Diagnosis_None <- ifelse(is.na(df$Diagnosis_None),0,1)
#I'm gonna remove rows that are almost all NA (all indicator variables are missing)
df <- df[complete.cases(df[,16]),]
colnames(df)[16:50] <-c('BR1','BR2','BR3','BR4','BR5','BR6','SOD1','SD1','SD2','SD3','SA1','SA2','SA3','SA4','NW1','NW2','NW3','P1','P2','P3','P4','P5','P6','P7','SDB1', 'SDB2', 'SDB3', 'DS1','DS2','DS3','DS4','DS5','DS6','DS7','DS8')
#reverse scoring the negative items
df$BR1 <- 4 - df$BR1
df$BR2 <- 4 - df$BR2
df$SOD1 <- 4 - df$SOD1
df$SD2 <- 4 - df$SD2
df$SD3 <- 4 - df$SD3
df$DS1 <- 4 - df$DS1
sleep_data_total_score <- rowSums(df[,16:50])
sleep_disorders <- ifelse(sleep_data_total_score >= 41,1,0)
df <- cbind(df,sleep_data_total_score,sleep_disorders)
#subsetting observations of primary age
df_primary_age <- df[which(df$ChildAge >= 4 & df$ChildAge <= 13),]
hist(df_primary_age$sleep_data_total_score, main = 'Primary School Age Sample Total Scores', probability = TRUE)
hist(df$sleep_data_total_score, main = 'Total Scores', probability = TRUE)
Other_indices <- c(7,12,14,43,47,48,54,70,110,112)
df_neurodiverse_group <- df_primary_age[df_primary_age$Diagnosis_ASD == 1 | df_primary_age$Diagnosis_ADHD == 1 | rownames(df_primary_age) %in% Other_indices, ]
df_neurotypical_group <- df_primary_age[!(df_primary_age$Diagnosis_ASD == 1 | df_primary_age$Diagnosis_ADHD == 1 | rownames(df_primary_age) %in% Other_indices), ]
p1 <- hist(df_neurodiverse_group$sleep_data_total_score, main = 'Neurodiverse group (primary age) total scores', probability = TRUE)
p2 <- hist(df_neurotypical_group$sleep_data_total_score, main = 'Neurotypical group (primary age) total scores', probability = TRUE)
mean_CSHQ_nd <- mean(df_neurodiverse_group$sleep_data_total_score)
mean_CSHQ_nt <- mean(df_neurotypical_group$sleep_data_total_score)
t.test(df_neurodiverse_group$sleep_data_total_score, df_neurotypical_group$sleep_data_total_score, var.equal = FALSE)
prop_nd <- nrow(df_neurodiverse_group)/nrow(df_primary_age)
nd_vec <- rowSums(df_primary_age[,c(9,10,12)])
nd_vec[c(79,103,137)] <- 0
nd_vec[which(nd_vec==2 | nd_vec == 3) ] <- 1
nd_vec <- as.numeric(nd_vec)
df_primary_age <- cbind(df_primary_age, nd_vec)
Y <- df_primary_age[,16:50]
#checking identifiability constraints
maxG(Y, 1:10)
#we see only the 2 group model is identifiable
blca_fit_2group <- blca.gibbs(X = Y, G = 2, iter = 5000, burn.in = 1000, verbose = TRUE)
pred_class <- apply(blca_fit_2group$Z, 1, which.max)
plot(blca_fit_2group)
df_primary_age_2group_latentgroupA <- df_primary_age[which(pred_class == 1),]
df_primary_age_2group_latentgroupB <- df_primary_age[which(pred_class == 2),]
mean(df_primary_age_2group_latentgroupA$sleep_data_total_score)
mean(df_primary_age_2group_latentgroupB$sleep_data_total_score)
Other_indices_groupA <- c(7,12,14,43,47,48,54,70,110,112)
df_neurodiverse_group_groupA <- df_primary_age_2group_latentgroupA[df_primary_age_2group_latentgroupA$Diagnosis_ASD == 1 | df_primary_age_2group_latentgroupA$Diagnosis_ADHD == 1 | rownames(df_primary_age_2group_latentgroupA) %in% Other_indices_groupA, ]
df_neurotypical_group_groupA <- df_primary_age_2group_latentgroupA[!(df_primary_age_2group_latentgroupA$Diagnosis_ASD == 1 | df_primary_age_2group_latentgroupA$Diagnosis_ADHD == 1 | rownames(df_primary_age_2group_latentgroupA) %in% Other_indices_groupA), ]
Other_indices_groupB <- c(1, 4, 5, 19, 30)
df_neurodiverse_group_groupB <- df_primary_age_2group_latentgroupB[df_primary_age_2group_latentgroupB$Diagnosis_ASD == 1 | df_primary_age_2group_latentgroupB$Diagnosis_ADHD == 1 | rownames(df_primary_age_2group_latentgroupB) %in% Other_indices_groupB, ]
df_neurotypical_group_groupB <- df_primary_age_2group_latentgroupB[!(df_primary_age_2group_latentgroupB$Diagnosis_ASD == 1 | df_primary_age_2group_latentgroupB$Diagnosis_ADHD == 1 | rownames(df_primary_age_2group_latentgroupB) %in% Other_indices_groupB), ]
#looking at proportions of each group that is neurodivergent
prop_nd_groupA <- nrow(df_neurodiverse_group_groupA)/nrow(df_primary_age_2group_latentgroupA)
prop_nd_groupB <- nrow(df_neurodiverse_group_groupB)/nrow(df_primary_age_2group_latentgroupB)
df_counts <- as.data.frame(table(nd_vec, (pred_class-1)))
colnames(df_counts) <- c("Neurodivergence", "LatentGroup", "Freq")
# Plot
ggplot(df_counts, aes(axis1 = Neurodivergence, axis2 = LatentGroup, y = Freq)) +
geom_alluvium(aes(fill = Neurodivergence), width = 1/6) +
geom_stratum(width = 1/6) +
geom_text(stat = "stratum", aes(label = after_stat(stratum))) +
scale_x_discrete(limits = c("Neurodivergence", "Fitted Class")) +
labs(title = "Alluvial Plot of Group Transitions") +
theme_minimal()
View(df_primary_age)
write.csv(df_primary_age, 'primary_age_sleep_data.csv', row.names = FALSE)
getwd()
