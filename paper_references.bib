	note = {\_eprint: https://onlinelibrary.wiley.com/doi/pdf/10.1111/j.1467-985X.2006.00419.x},
	keywords = {Categorical data, Data augmentation, Finite mixture, Markov chain Monte Carlo methods, Multiple imputation},
	pages = {723--743},
	file = {Full Text:C\:\\Users\\matth\\Zotero\\storage\\WVEFJT6H\\Chung et al. - 2006 - Latent class logistic regression application to marijuana use and attitudes among high school senio.pdf:application/pdf;Snapshot:C\:\\Users\\matth\\Zotero\\storage\\PDXQ9S6Y\\j.1467-985X.2006.00419.html:text/html},
